<Window
    x:Class="WinVora.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    Title="WinVora">

    <!-- LIQUID GLASS BACKDROP -->
    <Grid x:Name="RootGrid">

        <!-- THEME-BRUSHES: gemeinsam genutzte Instanzen, deren Color-Wert beim
             Umschalten zwischen Dunkel/Hell im Code-Behind (ApplyTheme) live
             verändert wird. Da überall dieselbe Brush-Instanz per StaticResource
             referenziert wird, aktualisiert sich die gesamte Oberfläche sofort,
             ohne dass jedes Element einzeln neu gesetzt werden muss.
             HINWEIS: In WinUI 3 hat "Window" (anders als in WPF) keine
             Resources-Eigenschaft - deshalb hängen die Resources hier am
             RootGrid statt am Window. -->
        <Grid.Resources>
            <SolidColorBrush x:Key="AppRootBackgroundBrush" Color="Black"/>

            <SolidColorBrush x:Key="AppForegroundBrush" Color="White"/>
            <SolidColorBrush x:Key="AppMutedForegroundBrush" Color="#B0FFFFFF"/>
            <SolidColorBrush x:Key="AppFaintForegroundBrush" Color="#AAFFFFFF"/>

            <SolidColorBrush x:Key="AppOverlay10" Color="#10FFFFFF"/>
            <SolidColorBrush x:Key="AppOverlay18" Color="#18FFFFFF"/>
            <SolidColorBrush x:Key="AppOverlay1A" Color="#1AFFFFFF"/>
            <SolidColorBrush x:Key="AppOverlay1E" Color="#1EFFFFFF"/>
            <SolidColorBrush x:Key="AppOverlay22" Color="#22FFFFFF"/>
            <SolidColorBrush x:Key="AppOverlay26" Color="#26FFFFFF"/>
            <SolidColorBrush x:Key="AppOverlay28" Color="#28FFFFFF"/>
            <SolidColorBrush x:Key="AppOverlay30" Color="#30FFFFFF"/>

            <SolidColorBrush x:Key="AppForegroundC0" Color="#C0FFFFFF"/>
            <SolidColorBrush x:Key="AppForegroundCC" Color="#CCFFFFFF"/>
            <SolidColorBrush x:Key="AppForegroundD8" Color="#D8FFFFFF"/>
        </Grid.Resources>

        <Grid.Background>
            <StaticResource ResourceKey="AppRootBackgroundBrush"/>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR GLASS -->

        <Border x:Name="SidebarCard"
        Grid.Column="0"
        Margin="12,44,12,12"
        CornerRadius="16"
        Background="{StaticResource AppOverlay18}"
        BorderBrush="{StaticResource AppOverlay26}"
        BorderThickness="1"
        Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Menü -->
                <StackPanel Grid.Row="0">
                    <Button Content="Übersicht"
        Click="Overview_Click"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Left"
        FontSize="18"
        FontWeight="SemiBold"
        MinHeight="56"
        Padding="18,14"
        Margin="0,0,0,12"/>

                    <Button Content="Systeminfo"
        Click="System_Click"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Left"
        FontSize="18"
        FontWeight="SemiBold"
        MinHeight="56"
        Padding="18,14"
        Margin="0,0,0,12"/>

                    <Button Content="Winget"
        Click="Updates_Click"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Left"
        FontSize="18"
        FontWeight="SemiBold"
        MinHeight="56"
        Padding="18,14"
        Margin="0,0,0,12"/>

                    <Button Content="Dateien"
        Click="Cleaner_Click"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Left"
        FontSize="18"
        FontWeight="SemiBold"
        MinHeight="56"
        Padding="18,14"/>
                </StackPanel>


                <!-- Einstellungen + Version / Changelog -->
                <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="10" Margin="0,20,0,0">

                    <Button Padding="12"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            CornerRadius="12"
                            Background="{StaticResource AppOverlay18}"
                            BorderBrush="{StaticResource AppOverlay30}"
                            BorderThickness="1"
                            Click="SettingsButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE713;" Foreground="{StaticResource AppForegroundBrush}" FontSize="18"/>
                            <TextBlock Text="Einstellungen"
                                       Foreground="{StaticResource AppForegroundBrush}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Button Padding="12"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        CornerRadius="12"
        Background="{StaticResource AppOverlay18}"
        BorderBrush="{StaticResource AppOverlay30}"
        BorderThickness="1"
        Click="ChangelogButton_Click">

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE789;"
                          Foreground="{StaticResource AppForegroundBrush}"
                          FontSize="18"/>

                                <TextBlock Text="Version 0.3.3"
               Foreground="{StaticResource AppForegroundBrush}"
               FontWeight="SemiBold"/>
                            </StackPanel>

                            <TextBlock Margin="0,8,0,0"
                       Foreground="{StaticResource AppMutedForegroundBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="Changelog anzeigen"/>
                        </StackPanel>
                    </Button>

                    <Button Padding="12"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            CornerRadius="12"
                            Background="{StaticResource AppOverlay18}"
                            BorderBrush="{StaticResource AppOverlay30}"
                            BorderThickness="1"
                            Click="ContactButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE715;" Foreground="{StaticResource AppForegroundBrush}" FontSize="18"/>
                            <TextBlock Text="Kontakt"
                                       Foreground="{StaticResource AppForegroundBrush}"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>


        <!-- MAIN GLASS -->
        <Border x:Name="MainCard"
                Grid.Column="1"
                Margin="12,44,12,12"
                CornerRadius="16"
                Background="{StaticResource AppOverlay10}"
                BorderBrush="{StaticResource AppOverlay1E}"
                BorderThickness="1"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <StackPanel Orientation="Horizontal"
                Spacing="12"
                VerticalAlignment="Center">

                            <TextBlock x:Name="PageTitle"
                   Text="Übersicht"
                   FontSize="34"
                   FontWeight="Bold"
                   Foreground="{StaticResource AppForegroundBrush}"/>

                            <ProgressRing x:Name="UpdatesLoadingRing"
                      IsActive="False"
                      Visibility="Collapsed"
                      Width="22"
                      Height="22"
                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="PageSubtitle"
               Foreground="{StaticResource AppFaintForegroundBrush}"/>
                    </StackPanel>

                    <!-- Nur auf der Apps-Seite sichtbar -->
                    <StackPanel x:Name="AppsActionBar"
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="10"
            VerticalAlignment="Center"
            Visibility="Collapsed">

                        <Button x:Name="WingetSelectAllButton"
            Content="Alle abwählen"
            FontSize="15"
            FontWeight="SemiBold"
            Padding="16,10"
            Click="WingetSelectAll_Click"/>

                        <Button x:Name="RefreshButton"
            Content="Refresh"
            FontSize="15"
            FontWeight="SemiBold"
            Padding="16,10"
            Click="Refresh_Click"/>

                        <Button x:Name="StartUpdateButton"
            Content="Start Update"
            FontSize="15"
            FontWeight="SemiBold"
            Padding="16,10"
            Click="StartUpdate_Click"
            Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>

                    <!-- Nur auf der Systeminfo-Seite sichtbar -->
                    <StackPanel x:Name="SystemActionBar"
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="10"
            VerticalAlignment="Center"
            Visibility="Collapsed">

                        <Button Content="Aktualisieren"
            FontSize="15"
            FontWeight="SemiBold"
            Padding="16,10"
            Click="RefreshSystemInfo_Click"/>

                        <Button Content="Alles aufklappen"
            FontSize="15"
            FontWeight="SemiBold"
            Padding="16,10"
            Click="ExpandAllSystem_Click"/>

                        <Button Content="Alles einklappen"
            FontSize="15"
            FontWeight="SemiBold"
            Padding="16,10"
            Click="CollapseAllSystem_Click"/>
                    </StackPanel>

                    <!-- Nur auf der Storage-Seite sichtbar -->
                    <StackPanel x:Name="StorageActionBar"
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="10"
            VerticalAlignment="Center"
            Visibility="Collapsed">

                        <Button x:Name="StorageSelectAllButton"
            Content="Alle auswählen"
            FontSize="15"
            FontWeight="SemiBold"
            Padding="16,10"
            Click="StorageSelectAll_Click"/>

                        <Button x:Name="StorageRefreshButton"
            Content="Refresh"
            FontSize="15"
            FontWeight="SemiBold"
            Padding="16,10"
            Click="StorageRefresh_Click"/>

                        <Button x:Name="StorageDeleteSelectedButton"
            Content="Alle ausgewählten löschen"
            FontSize="15"
            FontWeight="SemiBold"
            Padding="16,10"
            Click="StorageDeleteSelected_Click"
            Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>
                </Grid>

                <!-- Fortschrittsanzeige während der Installation -->
                <StackPanel x:Name="UpdateProgressPanel"
                            Grid.Row="1"
                            Spacing="6"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">

                    <TextBlock x:Name="UpdateProgressText"
                               Foreground="{StaticResource AppForegroundBrush}"
                               FontSize="13"/>

                    <ProgressBar x:Name="UpdateProgressBar"
                                 Minimum="0"
                                 Maximum="100"/>

                    <TextBlock x:Name="CurrentPackageStatusText"
                               Foreground="{StaticResource AppFaintForegroundBrush}"
                               FontSize="12"/>

                    <ProgressBar x:Name="CurrentPackageProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Height="4"/>
                </StackPanel>

                <!-- Fortschrittsanzeige während der Bereinigung -->
                <StackPanel x:Name="StorageProgressPanel"
                            Grid.Row="1"
                            Spacing="6"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">

                    <TextBlock x:Name="StorageProgressText"
                               Foreground="{StaticResource AppForegroundBrush}"
                               FontSize="13"/>

                    <ProgressBar x:Name="StorageProgressBar"
                                 Minimum="0"
                                 Maximum="100"/>
                </StackPanel>

                <ScrollViewer Grid.Row="2"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto">

                    <Grid>

                        <!-- SYSTEM -->

                        <!-- OVERVIEW -->
                        <StackPanel x:Name="OverviewPanel"
            Spacing="20"
            HorizontalAlignment="Stretch"
            Visibility="Visible">

                            <controls:SettingsCard Header="Übersicht"
                           HorizontalAlignment="Stretch"
                           MinHeight="180"
                           Padding="30">
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" CornerRadius="16" Padding="22" Background="{StaticResource AppOverlay1A}" BorderBrush="{StaticResource AppOverlay28}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="CPU" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock x:Name="HealthCpuText" Text="--%" FontSize="34" FontWeight="Bold" Foreground="{StaticResource AppForegroundBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" CornerRadius="16" Padding="22" Background="{StaticResource AppOverlay1A}" BorderBrush="{StaticResource AppOverlay28}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="RAM" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock x:Name="HealthRamText" Text="--%" FontSize="34" FontWeight="Bold" Foreground="{StaticResource AppForegroundBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" CornerRadius="16" Padding="22" Background="{StaticResource AppOverlay1A}" BorderBrush="{StaticResource AppOverlay28}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Sicherheit" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock x:Name="HealthSecurityText" Text="--" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AppForegroundBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="3" CornerRadius="16" Padding="22" Background="{StaticResource AppOverlay1A}" BorderBrush="{StaticResource AppOverlay28}" BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="Updates" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock x:Name="HealthUpdatesText" Text="--" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AppForegroundBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </controls:SettingsCard>

                            <controls:SettingsCard Header="Schnellzugriff"
                           HorizontalAlignment="Stretch"
                           MinHeight="130"
                           Padding="26">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <Button Content="Systeminfo öffnen"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Padding="18,12"
                    Click="System_Click"/>

                                    <Button Content="Winget prüfen"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Padding="18,12"
                    Click="Updates_Click"/>

                                    <Button Content="Dateien öffnen"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Padding="18,12"
                    Click="Cleaner_Click"/>
                                </StackPanel>
                            </controls:SettingsCard>
                        </StackPanel>

                        <StackPanel x:Name="SystemPanel"
            Spacing="20"
            HorizontalAlignment="Stretch"
              Visibility="Collapsed">

                            <Expander x:Name="DeviceExpander" Header="Gerät" IsExpanded="False" FontSize="20" FontWeight="SemiBold" MinHeight="64" Padding="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid Padding="0,18,0,0" HorizontalAlignment="Stretch">
                                    <controls:SettingsCard Header="Geräteinformationen" HorizontalAlignment="Stretch" MinHeight="190" Padding="30">
                                        <Grid ColumnSpacing="44" RowSpacing="18" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Computername" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SysComputerName" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Benutzername" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SysUserName" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Hersteller / Modell" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SysManufacturerModel" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Seriennummer" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SysSerialNumber" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Architektur" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SysArchitecture" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                        </Grid>
                                    </controls:SettingsCard>
                                </Grid>
                            </Expander>

                            <Expander x:Name="OsExpander" Header="Betriebssystem" IsExpanded="False" FontSize="20" FontWeight="SemiBold" MinHeight="64" Padding="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid Padding="0,18,0,0" HorizontalAlignment="Stretch">
                                    <controls:SettingsCard Header="Windows" HorizontalAlignment="Stretch" MinHeight="300" Padding="30">
                                        <Grid ColumnSpacing="44" RowSpacing="18" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Windows Edition" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SysEdition" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Version / Build" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SysVersionBuild" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Installationsdatum" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SysInstallDate" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Letztes Windows Update" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SysLastUpdate" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Aktivierungsstatus" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SysActivation" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Uptime" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="SysUptime" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="6" Grid.Column="0" Text=".NET Version" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="6" Grid.Column="1" x:Name="SysDotNet" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="7" Grid.Column="0" Text="DirectX Version" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="7" Grid.Column="1" x:Name="SysDirectX" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                        </Grid>
                                    </controls:SettingsCard>
                                </Grid>
                            </Expander>

                            <Expander x:Name="CpuExpander" Header="Prozessor" IsExpanded="False" FontSize="20" FontWeight="SemiBold" MinHeight="64" Padding="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid Padding="0,18,0,0" HorizontalAlignment="Stretch">
                                    <controls:SettingsCard Header="CPU" HorizontalAlignment="Stretch" MinHeight="190" Padding="30">
                                        <Grid ColumnSpacing="44" RowSpacing="20" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Modell" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SysCpuName" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Kerne / Threads / Takt" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SysCpuDetails" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Auslastung Live" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right">
                                                <ProgressBar x:Name="SysCpuUsageBar" Width="260" Height="12" Maximum="100"/>
                                                <TextBlock x:Name="SysCpuUsageText" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" MinWidth="50"/>
                                            </StackPanel>
                                        </Grid>
                                    </controls:SettingsCard>
                                </Grid>
                            </Expander>

                            <Expander x:Name="RamExpander" Header="Arbeitsspeicher" IsExpanded="False" FontSize="20" FontWeight="SemiBold" MinHeight="64" Padding="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid Padding="0,18,0,0" HorizontalAlignment="Stretch">
                                    <controls:SettingsCard Header="RAM" HorizontalAlignment="Stretch" MinHeight="165" Padding="30">
                                        <Grid ColumnSpacing="44" RowSpacing="20" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Installiert / Belegt / Frei" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SysRamDetails" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Auslastung Live" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="14" HorizontalAlignment="Right">
                                                <ProgressBar x:Name="SysRamUsageBar" Width="260" Height="12" Maximum="100"/>
                                                <TextBlock x:Name="SysRamUsageText" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" MinWidth="50"/>
                                            </StackPanel>
                                        </Grid>
                                    </controls:SettingsCard>
                                </Grid>
                            </Expander>

                            <Expander x:Name="BoardExpander" Header="Mainboard und BIOS" IsExpanded="False" FontSize="20" FontWeight="SemiBold" MinHeight="64" Padding="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid Padding="0,18,0,0" HorizontalAlignment="Stretch">
                                    <controls:SettingsCard Header="Hardware" HorizontalAlignment="Stretch" MinHeight="150" Padding="30">
                                        <Grid ColumnSpacing="44" RowSpacing="20" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Mainboard" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SysMainboard" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="BIOS-Version" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SysBios" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right" TextWrapping="Wrap"/>
                                        </Grid>
                                    </controls:SettingsCard>
                                </Grid>
                            </Expander>

                            <Expander x:Name="SecurityExpander" Header="Sicherheit" IsExpanded="False" FontSize="20" FontWeight="SemiBold" MinHeight="64" Padding="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid Padding="0,18,0,0" HorizontalAlignment="Stretch">
                                    <controls:SettingsCard Header="Sicherheitsstatus" HorizontalAlignment="Stretch" MinHeight="255" Padding="30">
                                        <Grid ColumnSpacing="44" RowSpacing="18" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Secure Boot" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SysSecureBoot" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="TPM" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SysTpm" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Virtualisierung" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SysVirtualization" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Windows Defender" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SysDefender" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Firewall" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SysFirewall" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="BitLocker" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="SysBitLocker" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right" TextWrapping="Wrap"/>
                                        </Grid>
                                    </controls:SettingsCard>
                                </Grid>
                            </Expander>

                            <Expander x:Name="GpuExpander" Header="Grafik" IsExpanded="False" FontSize="20" FontWeight="SemiBold" MinHeight="64" Padding="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid Padding="0,18,0,0" HorizontalAlignment="Stretch">
                                    <controls:SettingsCard Header="Grafikkarten" HorizontalAlignment="Stretch" MinHeight="165" Padding="30">
                                        <StackPanel x:Name="SysGpuPanel" Spacing="12" HorizontalAlignment="Stretch"/>
                                    </controls:SettingsCard>
                                </Grid>
                            </Expander>

                            <Expander x:Name="DrivesExpander" Header="Laufwerke" IsExpanded="False" FontSize="20" FontWeight="SemiBold" MinHeight="64" Padding="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid Padding="0,18,0,0" HorizontalAlignment="Stretch">
                                    <controls:SettingsCard Header="Speicherlaufwerke" HorizontalAlignment="Stretch" MinHeight="165" Padding="30">
                                        <StackPanel x:Name="SysDrivesPanel" Spacing="12" HorizontalAlignment="Stretch"/>
                                    </controls:SettingsCard>
                                </Grid>
                            </Expander>

                            <Expander x:Name="NetworkExpander" Header="Netzwerk" IsExpanded="False" FontSize="20" FontWeight="SemiBold" MinHeight="64" Padding="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid Padding="0,18,0,0" HorizontalAlignment="Stretch">
                                    <controls:SettingsCard Header="Aktive Netzwerkadapter" HorizontalAlignment="Stretch" MinHeight="165" Padding="30">
                                        <StackPanel x:Name="SysNetworkPanel" Spacing="12" HorizontalAlignment="Stretch"/>
                                    </controls:SettingsCard>
                                </Grid>
                            </Expander>

                            <Expander x:Name="BatteryExpander" Header="Akku" IsExpanded="False" FontSize="20" FontWeight="SemiBold" MinHeight="64" Padding="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid Padding="0,18,0,0" HorizontalAlignment="Stretch">
                                    <controls:SettingsCard Header="Energie" HorizontalAlignment="Stretch" MinHeight="120" Padding="30">
                                        <Grid ColumnSpacing="44" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Akkustatus" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Column="1" x:Name="SysBattery" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                        </Grid>
                                    </controls:SettingsCard>
                                </Grid>
                            </Expander>

                            <Border Height="28"/>
                        </StackPanel>

                        <!-- WINGET -->
                        <StackPanel x:Name="ContentArea"
                                    Spacing="10"
                                    Visibility="Collapsed"/>

                        <!-- STORAGE -->
                        <StackPanel x:Name="StoragePanel"
                                    Spacing="10"
                                    Visibility="Collapsed"/>

                    </Grid>
                </ScrollViewer>

            </Grid>
        </Border>

        <!-- Bereich zum Verschieben des Fensters (ersetzt die weiße System-Titelleiste),
             zeigt jetzt zusätzlich unser eigenes Logo + Namen oben links, da das
             von Windows gezeichnete Icon+Titel-Feld ja ausgeblendet ist. -->
        <Border x:Name="TitleBarDragRegion"
                Grid.ColumnSpan="2"
                Height="40"
                VerticalAlignment="Top"
                Background="Transparent">

            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">

                <Border Width="22" Height="22" CornerRadius="6" Background="Black">
                    <TextBlock Text="W"
                               FontWeight="Bold"
                               FontSize="13"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="WinVora"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Foreground="{StaticResource AppForegroundBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Dünne Trennlinie unter der Titelleiste, damit der obere Fensterrand
             (wo die Fenster-Buttons liegen) sauber vom Glas-Inhalt abgesetzt ist. -->
        <Border x:Name="TitleBarDivider"
                Grid.ColumnSpan="2"
                Height="1"
                VerticalAlignment="Top"
                Margin="0,32,0,0"
                Background="{StaticResource AppOverlay1E}"/>

        <!-- STARTUP-OVERLAY -->
        <Border x:Name="StartupOverlay"
                Grid.ColumnSpan="2"
                Background="{StaticResource AppRootBackgroundBrush}"
                Opacity="1"
                Visibility="Visible">

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="20">

                <TextBlock Text="WinVora"
                           FontSize="40"
                           FontWeight="Bold"
                           Foreground="{StaticResource AppForegroundBrush}"
                           HorizontalAlignment="Center"/>

                <ProgressRing IsActive="True"
                              Width="36"
                              Height="36"
                              HorizontalAlignment="Center"/>

                <TextBlock x:Name="StartupStatusText"
                           Text="Wird geladen..."
                           FontSize="15"
                           Foreground="{StaticResource AppFaintForegroundBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>