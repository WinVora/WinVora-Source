                                    <controls:SettingsCard x:Name="SysCardSecurity" Header="Sicherheitsstatus" CornerRadius="16" HorizontalAlignment="Stretch" MinHeight="220" Padding="22">
                                        <Grid ColumnSpacing="44" RowSpacing="18" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="SysLbl21" Text="Secure Boot" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SysSecureBoot" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="SysLbl22" Text="TPM" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SysTpm" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" x:Name="SysLbl23" Text="Virtualisierung" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SysVirtualization" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" x:Name="SysLbl24" Text="Windows Defender" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SysDefender" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="4" Grid.Column="0" x:Name="SysLbl25" Text="Firewall" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SysFirewall" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="5" Grid.Column="0" x:Name="SysLbl26" Text="BitLocker" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="5" Grid.Column="1" x:Name="SysBitLocker" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right" TextWrapping="Wrap"/>
                                        </Grid>
                                    </controls:SettingsCard>
                                </Grid>
                            </Expander>

                            <Expander x:Name="GpuExpander" Header="Grafik" IsExpanded="False" FontSize="20" FontWeight="SemiBold" MinHeight="64" Padding="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid Padding="0,18,0,0" HorizontalAlignment="Stretch">
                                    <controls:SettingsCard x:Name="SysCardGpu" Header="Grafikkarten" CornerRadius="16" HorizontalAlignment="Stretch" MinHeight="140" Padding="22">
                                        <StackPanel x:Name="SysGpuPanel" Spacing="12" HorizontalAlignment="Stretch"/>
                                    </controls:SettingsCard>
                                </Grid>
                            </Expander>

                            <Expander x:Name="DrivesExpander" Header="Laufwerke" IsExpanded="False" FontSize="20" FontWeight="SemiBold" MinHeight="64" Padding="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid Padding="0,18,0,0" HorizontalAlignment="Stretch">
                                    <controls:SettingsCard x:Name="SysCardDrives" Header="Speicherlaufwerke" CornerRadius="16" HorizontalAlignment="Stretch" MinHeight="140" Padding="22">
                                        <StackPanel x:Name="SysDrivesPanel" Spacing="12" HorizontalAlignment="Stretch"/>
                                    </controls:SettingsCard>
                                </Grid>
                            </Expander>

                            <Expander x:Name="NetworkExpander" Header="Netzwerk" IsExpanded="False" FontSize="20" FontWeight="SemiBold" MinHeight="64" Padding="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid Padding="0,18,0,0" HorizontalAlignment="Stretch">
                                    <controls:SettingsCard x:Name="SysCardNetwork" Header="Aktive Netzwerkadapter" CornerRadius="16" HorizontalAlignment="Stretch" MinHeight="140" Padding="22">
                                        <StackPanel x:Name="SysNetworkPanel" Spacing="12" HorizontalAlignment="Stretch"/>
                                    </controls:SettingsCard>
                                </Grid>
                            </Expander>

                            <Expander x:Name="BatteryExpander" Header="Akku" IsExpanded="False" FontSize="20" FontWeight="SemiBold" MinHeight="64" Padding="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid Padding="0,18,0,0" HorizontalAlignment="Stretch">
                                    <controls:SettingsCard x:Name="SysCardBattery" Header="Energie" CornerRadius="16" HorizontalAlignment="Stretch" MinHeight="105" Padding="22">
                                        <Grid ColumnSpacing="44" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Akkustatus" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Column="1" x:Name="SysBattery" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                        </Grid>
                                    </controls:SettingsCard>
                                </Grid>
                            </Expander>

                            <Border Height="28"/>
                        </StackPanel>

                        <StackPanel x:Name="HistoryPanel" Spacing="14" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="HistoryAllButton" Content="Alle" Tag="All" Click="HistoryChip_Click"/>
                                <Button x:Name="HistorySuccessButton" Content="Erfolgreich" Tag="Successful" Click="HistoryChip_Click"/>
                                <Button x:Name="HistoryFailedButton" Content="Fehler" Tag="Failed" Click="HistoryChip_Click"/>
                                <Button x:Name="HistoryCancelledButton" Content="Abgebrochen" Tag="Cancelled" Click="HistoryChip_Click"/>
                                <Button x:Name="HistoryRestartButton" Content="Neustart" Tag="RestartRequired" Click="HistoryChip_Click"/>
                                <Button Content="Filter zurücksetzen" Click="HistoryResetFilters_Click"/>
                                <Button Content="Verlauf leeren" Click="HistoryClearAll_Click"/>
                                <Button Content="Exportieren">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Verlauf als Textdatei" Click="ExportHistory_Click"/>
                                            <MenuFlyoutItem Text="Systembericht als Textdatei" Click="ExportSystemReport_Click"/>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="HistorySearchBox" PlaceholderText="Verlauf durchsuchen..."
                                         TextChanged="HistorySearchBox_TextChanged"/>
                                <DatePicker x:Name="HistoryFromDatePicker" Grid.Column="1" Header="Von"
                                            DateChanged="HistoryDatePicker_DateChanged"/>
                                <DatePicker x:Name="HistoryToDatePicker" Grid.Column="2" Header="Bis"
                                            DateChanged="HistoryDatePicker_DateChanged"/>
                            </Grid>
                            <StackPanel x:Name="HistoryListPanel" Spacing="10"/>
                        </StackPanel>

                        <StackPanel x:Name="AutostartPanel" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Programme, die automatisch mit Windows starten" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                            <StackPanel x:Name="AutostartListPanel" Spacing="10"/>
                        </StackPanel>

                        <!-- WINGET -->
                        <StackPanel x:Name="ContentArea"
                                    Spacing="10"
                                    Visibility="Collapsed"/>

                        <!-- STORAGE -->
                        <StackPanel x:Name="StoragePanel"
                                    Spacing="10"
                                    Visibility="Collapsed"/>

                        <!-- DEINSTALLIEREN -->
                        <StackPanel x:Name="UninstallPanel"
                                    Spacing="10"
                                    Visibility="Collapsed"/>

                    </Grid>
                </ScrollViewer>

            </Grid>
        </Border>

        <!-- Bereich zum Verschieben des Fensters (ersetzt die weiße System-Titelleiste),
             zeigt jetzt zusätzlich unser eigenes Logo + Namen oben links, da das
             von Windows gezeichnete Icon+Titel-Feld ja ausgeblendet ist. -->
        <Border x:Name="TitleBarDragRegion"
                Grid.ColumnSpan="2"
                Height="40"
                VerticalAlignment="Top"
                Background="Transparent">

            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="16,0,0,0">

                <!-- Dieselbe Quelldatei wie Fenster, EXE und Installer verwenden. -->
                <Image Width="22"
                       Height="22"
                       Source="app-logo.png"
                       Stretch="Uniform"
                       AutomationProperties.Name="WinVora-Logo"/>

                <TextBlock Text="WinVora"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Foreground="{StaticResource AppForegroundBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Dünne Trennlinie unter der Titelleiste, damit der obere Fensterrand
             (wo die Fenster-Buttons liegen) sauber vom Glas-Inhalt abgesetzt ist. -->
        <Border x:Name="TitleBarDivider"
                Grid.ColumnSpan="2"
                Height="1"
                VerticalAlignment="Top"
                Margin="0,31,0,0"
                Background="{StaticResource AppOverlay1E}"/>

        <Border x:Name="GlobalStatusBar" Grid.ColumnSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,18" Padding="14,8" CornerRadius="12"
                Background="{StaticResource AppOverlay30}" BorderBrush="{StaticResource AppOverlay30}" BorderThickness="1"
                Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="9">
                <ProgressRing x:Name="GlobalStatusRing" Width="16" Height="16" IsActive="True"/>
                <TextBlock x:Name="GlobalStatusText" Text="Wird geladen..." VerticalAlignment="Center" FontSize="12"/>
            </StackPanel>
        </Border>

        <InfoBar x:Name="AppInfoBar"
                 Grid.Column="1"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Top"
                 Margin="0,54,36,0"
                 MaxWidth="520"
                 IsOpen="False"
                 IsClosable="True"/>

        <!-- STARTUP-OVERLAY -->
        <Border x:Name="StartupOverlay"
                Grid.ColumnSpan="2"
                Background="#141416"
                Opacity="1"
                Visibility="Visible"
                Loaded="StartupOverlay_Loaded">

            <Grid>
                <!-- Container für mehrere Liquid-Glass-Bänder, die per Code-behind
                     erzeugt werden (unterschiedliche Größen/Wege/Startzeiten,
                     siehe CreateGlassBand() in MainWindow.xaml.cs). -->
                <Canvas x:Name="StartupGlassBandsHost"/>

                <!-- Ruhige Kontrastfläche vor dem animierten Wabenraster. -->
                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0">
                    <StackPanel Spacing="16">
                        <Border Width="76"
                                Height="76"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Center">
                            <Image Width="68"
                                   Height="68"
                                   Source="app-logo.png"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="WinVora-Logo"/>
                        </Border>

                        <TextBlock Text="WinVora"
                                   FontSize="38"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFFFF"
                                   CharacterSpacing="15"
                                   HorizontalAlignment="Center"/>

                        <Border Padding="14,8"
                                CornerRadius="10"
                                Background="#CC18181D"
                                BorderBrush="#356C5CE7"
                                BorderThickness="1"
                                HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <ProgressRing IsActive="True"
                                              Width="20"
                                              Height="20"
                                              Foreground="#FF8B7CF6"
                                              VerticalAlignment="Center"/>
                                <TextBlock x:Name="StartupStatusText"
                                           Text="Wird geladen..."
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#FFF2F2F5"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Spacing="6" Width="240">
                            <ProgressBar x:Name="StartupProgressBar" Minimum="0" Maximum="4" Value="0" Height="5"
                                         Foreground="#FF8B7CF6"/>
                            <TextBlock x:Name="StartupProgressText" Text="0 von 4 abgeschlossen"
                                       FontSize="11" Foreground="#BFFFFFFF" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

    </Grid>
</Window>
