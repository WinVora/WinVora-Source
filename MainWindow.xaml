                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" x:Name="DashCardDisk" Tapped="DashDisk_Tapped" CornerRadius="16" Padding="18" Background="{StaticResource AppOverlay10}" BorderBrush="{StaticResource AppOverlay22}" BorderThickness="1" ToolTipService.ToolTip="Dateibereinigung öffnen">
                                        <StackPanel Spacing="6">
                                            <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{StaticResource AppAccentBrushLight}"/>
                                            <TextBlock x:Name="LblDashDisk" Text="Speicherplatz" FontSize="12" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock x:Name="DashDiskText" Text="--" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppForegroundBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="1" x:Name="DashCardTemp" CornerRadius="16" Padding="18" Background="{StaticResource AppOverlay10}" BorderBrush="{StaticResource AppOverlay22}" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <FontIcon Glyph="&#xE9CA;" FontSize="16" Foreground="{StaticResource AppAccentBrushLight}"/>
                                            <TextBlock x:Name="LblDashTemp" Text="Windows-Version" FontSize="12" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock x:Name="DashTempText" Text="Wird ermittelt..." FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppFaintForegroundBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="2" x:Name="DashCardPrograms" Tapped="DashPrograms_Tapped" CornerRadius="16" Padding="18" Background="{StaticResource AppOverlay10}" BorderBrush="{StaticResource AppOverlay22}" BorderThickness="1" ToolTipService.ToolTip="Installierte Programme öffnen">
                                        <StackPanel Spacing="6">
                                            <FontIcon Glyph="&#xE71D;" FontSize="16" Foreground="{StaticResource AppAccentBrushLight}"/>
                                            <TextBlock x:Name="LblDashPrograms" Text="Programme" FontSize="12" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock x:Name="DashInstalledCountText" Text="--" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppForegroundBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="3" x:Name="DashCardCleanup" Tapped="DashDisk_Tapped" CornerRadius="16" Padding="18" Background="{StaticResource AppOverlay10}" BorderBrush="{StaticResource AppOverlay22}" BorderThickness="1" ToolTipService.ToolTip="Dateibereinigung öffnen">
                                        <StackPanel Spacing="6">
                                            <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="{StaticResource AppAccentBrushLight}"/>
                                            <TextBlock x:Name="LblDashCleanup" Text="Zuletzt bereinigt" FontSize="12" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock x:Name="DashLastCleanupText" Text="--" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppForegroundBrush}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="0" x:Name="DashCardUpdatesDetail" Visibility="Collapsed" CornerRadius="16" Padding="18" Background="{StaticResource AppOverlay10}" BorderBrush="{StaticResource AppOverlay22}" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <FontIcon Glyph="&#xE895;" FontSize="16" Foreground="{StaticResource AppAccentBrushLight}"/>
                                            <TextBlock x:Name="LblDashUpdatesAvailable" Text="Verfügbare Updates" FontSize="12" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock x:Name="DashUpdatesCountText" Text="--" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppForegroundBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="1" x:Name="DashCardRam" Visibility="Collapsed" CornerRadius="16" Padding="18" Background="{StaticResource AppOverlay10}" BorderBrush="{StaticResource AppOverlay22}" BorderThickness="1">
                                        <StackPanel Spacing="6">
                                            <FontIcon Glyph="&#xEEA1;" FontSize="16" Foreground="{StaticResource AppAccentBrushLight}"/>
                                            <TextBlock x:Name="LblDashRam" Text="Arbeitsspeicher" FontSize="12" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock x:Name="DashRamDetailText" Text="--" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource AppForegroundBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" x:Name="DashCardStatus" CornerRadius="16" Padding="18,14"
                                            Background="{StaticResource AppAccentOverlay10}"
                                            BorderBrush="{StaticResource AppAccentOverlay20}" BorderThickness="1">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource AppAccentOverlay20}">
                                                    <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="{StaticResource AppAccentBrushLight}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1" x:Name="LblDashStatus" Text="Gesamtstatus" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" x:Name="DashOverallBadgeText" Text="Alles in Ordnung" FontSize="12" Foreground="#4CD973" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" CornerRadius="9" Padding="12,8" Background="{StaticResource AppOverlay10}"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse x:Name="DashUpdatesStatusDot" Width="8" Height="8" Fill="{StaticResource AppAccentBrushLight}"/><TextBlock x:Name="DashUpdatesStatusText" Text="Updates werden geprüft" TextWrapping="Wrap"/></StackPanel></Border>
                                                <Border Grid.Column="1" CornerRadius="9" Padding="12,8" Background="{StaticResource AppOverlay10}"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse x:Name="DashSecurityStatusDot" Width="8" Height="8" Fill="{StaticResource AppAccentBrushLight}"/><TextBlock x:Name="DashSecurityStatusText" Text="Sicherheit wird geprüft" TextWrapping="Wrap"/></StackPanel></Border>
                                                <Border Grid.Column="2" CornerRadius="9" Padding="12,8" Background="{StaticResource AppOverlay10}"><StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="8" Height="8" Fill="#4CD973"/><TextBlock x:Name="DashSystemStatusText" Text="Systemüberwachung läuft" TextWrapping="Wrap"/></StackPanel></Border>
                                            </Grid>
                                            <TextBlock x:Name="DashOverallStatusText" Text="Wird geprüft..." Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- ===== Mini-Verlaufsdiagramme (CPU/RAM/GPU) ===== -->
                            <!-- BUGFIX: SettingsCard richtet ihren Content-Bereich fest
                                 rechts aus und ignoriert HorizontalContentAlignment="Stretch" -
                                 dadurch wurden die Diagramme immer nur schmal am rechten Rand
                                 dargestellt, egal was am inneren Grid geändert wurde. Jetzt
                                 eine normale Border mit eigenem Header - volle Kontrolle. -->
                            <Border HorizontalAlignment="Stretch"
                                    CornerRadius="16"
                                    Padding="22"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid ColumnSpacing="18" RowSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                    <TextBlock x:Name="HistoryCard" Grid.Row="0" Grid.ColumnSpan="3" Text="Auslastung der letzten Minuten" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource AppForegroundBrush}" VerticalAlignment="Center"/>

                                    <!-- Gleicher Kachel-Stil wie die Live-Dashboard-Kacheln oben:
                                         Label + Wert INNERHALB desselben Rahmens, statt getrennt darüber. -->
                                    <Border Grid.Row="1" Grid.Column="0" CornerRadius="16" Padding="14" Background="{StaticResource AppOverlay10}" BorderBrush="{StaticResource AppOverlay22}" BorderThickness="1" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock x:Name="LblHistoryCpu" Text="CPU" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                                <TextBlock x:Name="CpuHistoryCurrentText" Text="--%" FontSize="12" Foreground="{StaticResource AppAccentBrushLight}"/>
                                            </StackPanel>
                                            <Canvas x:Name="CpuHistoryCanvas" Height="60" Background="Transparent" HorizontalAlignment="Stretch">
                                                <Polyline x:Name="CpuHistoryLine" Stroke="{StaticResource AppAccentBrush}" StrokeThickness="2"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Canvas>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="1" CornerRadius="16" Padding="14" Background="{StaticResource AppOverlay10}" BorderBrush="{StaticResource AppOverlay22}" BorderThickness="1" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock x:Name="LblHistoryRam" Text="RAM" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                                <TextBlock x:Name="RamHistoryCurrentText" Text="--%" FontSize="12" Foreground="{StaticResource AppAccentBrushLight}"/>
                                            </StackPanel>
                                            <Canvas x:Name="RamHistoryCanvas" Height="60" Background="Transparent" HorizontalAlignment="Stretch">
                                                <Polyline x:Name="RamHistoryLine" Stroke="{StaticResource AppAccentBrush}" StrokeThickness="2"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Canvas>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="2" CornerRadius="16" Padding="14" Background="{StaticResource AppOverlay10}" BorderBrush="{StaticResource AppOverlay22}" BorderThickness="1" HorizontalAlignment="Stretch">
                                        <StackPanel Spacing="8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock x:Name="LblHistoryGpu" Text="GPU" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                                <TextBlock x:Name="GpuHistoryCurrentText" Text="--%" FontSize="12" Foreground="{StaticResource AppAccentBrushLight}"/>
                                            </StackPanel>
                                            <Canvas x:Name="GpuHistoryCanvas" Height="60" Background="Transparent" HorizontalAlignment="Stretch">
                                                <Polyline x:Name="GpuHistoryLine" Stroke="{StaticResource AppAccentBrush}" StrokeThickness="2"
                                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Canvas>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                        </StackPanel>

                        <StackPanel x:Name="SystemPanel"
            Spacing="20"
            HorizontalAlignment="Stretch"
              Visibility="Collapsed">

                            <Expander x:Name="DeviceExpander" Header="Gerät" IsExpanded="False" FontSize="20" FontWeight="SemiBold" MinHeight="64" Padding="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid Padding="0,18,0,0" HorizontalAlignment="Stretch">
                                    <controls:SettingsCard x:Name="SysCardDevice" Header="Geräteinformationen" CornerRadius="16" HorizontalAlignment="Stretch" MinHeight="160" Padding="22">
                                        <Grid ColumnSpacing="44" RowSpacing="18" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="SysLbl01" Text="Computername" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SysComputerName" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="SysLbl02" Text="Benutzername" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SysUserName" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" x:Name="SysLbl03" Text="Hersteller / Modell" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SysManufacturerModel" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="3" Grid.Column="0" x:Name="SysLbl04" Text="Seriennummer" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SysSerialNumber" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="4" Grid.Column="0" x:Name="SysLbl05" Text="Architektur" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="SysArchitecture" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                        </Grid>
                                    </controls:SettingsCard>
                                </Grid>
                            </Expander>

                            <Expander x:Name="OsExpander" Header="Betriebssystem" IsExpanded="False" FontSize="20" FontWeight="SemiBold" MinHeight="64" Padding="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Grid Padding="0,18,0,0" HorizontalAlignment="Stretch">
                                    <controls:SettingsCard x:Name="SysCardOs" Header="Windows" CornerRadius="16" HorizontalAlignment="Stretch" MinHeight="250" Padding="22">
                                        <Grid ColumnSpacing="44" RowSpacing="18" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="SysLbl06" Text="Windows Edition" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SysEdition" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" x:Name="SysLbl07" Text="Version / Build" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SysVersionBuild" FontSize="16" Foreground="{StaticResource AppForegroundBrush}" TextAlignment="Right"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" x:Name="SysLbl08" Text="Installationsdatum" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
