<Window
    x:Class="WinVora.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    Title="WinVora">

    <!-- LIQUID GLASS BACKDROP -->
    <Grid x:Name="RootGrid" KeyboardAcceleratorPlacementMode="Hidden" UseSystemFocusVisuals="True">

        <!-- THEME-BRUSHES: gemeinsam genutzte Instanzen, deren Color-Wert beim
             Umschalten zwischen Dunkel/Hell im Code-Behind (ApplyTheme) live
             verändert wird. Da überall dieselbe Brush-Instanz per StaticResource
             referenziert wird, aktualisiert sich die gesamte Oberfläche sofort,
             ohne dass jedes Element einzeln neu gesetzt werden muss.
             HINWEIS: In WinUI 3 hat "Window" (anders als in WPF) keine
             Resources-Eigenschaft - deshalb hängen die Resources hier am
             RootGrid statt am Window. -->
        <Grid.Resources>
            <SolidColorBrush x:Key="AppRootBackgroundBrush" Color="#F0000000"/>

            <SolidColorBrush x:Key="AppForegroundBrush" Color="White"/>
            <SolidColorBrush x:Key="AppMutedForegroundBrush" Color="#B0FFFFFF"/>
            <SolidColorBrush x:Key="AppFaintForegroundBrush" Color="#AAFFFFFF"/>

            <SolidColorBrush x:Key="AppOverlay10" Color="#10FFFFFF"/>
            <SolidColorBrush x:Key="AppOverlay18" Color="#18FFFFFF"/>
            <SolidColorBrush x:Key="AppOverlay1A" Color="#1AFFFFFF"/>
            <SolidColorBrush x:Key="AppOverlay1E" Color="#1EFFFFFF"/>
            <SolidColorBrush x:Key="AppOverlay22" Color="#22FFFFFF"/>
            <SolidColorBrush x:Key="AppOverlay26" Color="#26FFFFFF"/>
            <SolidColorBrush x:Key="AppOverlay28" Color="#28FFFFFF"/>
            <SolidColorBrush x:Key="AppOverlay30" Color="#30FFFFFF"/>

            <SolidColorBrush x:Key="AppForegroundC0" Color="#C0FFFFFF"/>
            <SolidColorBrush x:Key="AppForegroundCC" Color="#CCFFFFFF"/>
            <SolidColorBrush x:Key="AppForegroundD8" Color="#D8FFFFFF"/>

            <!-- Akzentfarbe: modernes Violett-Blau, für aktive Navigation,
                 Fortschrittsbalken, "Alles aktuell"-Status und Hover-Zustände -->
            <SolidColorBrush x:Key="AppAccentBrush" Color="#6C5CE7"/>
            <SolidColorBrush x:Key="AppAccentBrushLight" Color="#8B7CF6"/>
            <SolidColorBrush x:Key="AppAccentOverlay20" Color="#336C5CE7"/>
            <SolidColorBrush x:Key="AppAccentOverlay10" Color="#1A6C5CE7"/>
        </Grid.Resources>

        <Grid.Background>
            <StaticResource ResourceKey="AppRootBackgroundBrush"/>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR GLASS -->

        <Border x:Name="SidebarCard"
        Grid.Column="0"
        Margin="12,44,12,12"
        CornerRadius="16"
        Background="{StaticResource AppOverlay18}"
        BorderBrush="{StaticResource AppOverlay26}"
        BorderThickness="1"
        Padding="20">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Menü -->
                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button x:Name="NavOverviewButton" Click="Overview_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="18" FontWeight="SemiBold" MinHeight="56" Padding="18,14" Margin="0,0,0,12"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE80F;"/><TextBlock x:Name="LblNavDashboard" Text="Dashboard"/></StackPanel></Button>
                        <Button x:Name="NavSystemButton" Click="System_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="18" FontWeight="SemiBold" MinHeight="56" Padding="18,14" Margin="0,0,0,12"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE950;"/><TextBlock x:Name="LblNavSystem" Text="Systeminfo"/></StackPanel></Button>
                        <Button x:Name="NavUpdatesButton" Click="Updates_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="18" FontWeight="SemiBold" MinHeight="56" Padding="18,14" Margin="0,0,0,12"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE895;"/><TextBlock x:Name="LblNavUpdates" Text="Programm-Updates"/></StackPanel></Button>
                        <Button x:Name="NavCleanerButton" Click="Cleaner_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="18" FontWeight="SemiBold" MinHeight="56" Padding="18,14" Margin="0,0,0,12"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8B7;"/><TextBlock x:Name="LblNavFiles" Text="Dateien"/></StackPanel></Button>
                        <Button x:Name="NavUninstallButton" Click="Uninstaller_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" FontSize="18" FontWeight="SemiBold" MinHeight="56" Padding="18,14"><StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE74D;"/><TextBlock x:Name="LblNavUninstall" Text="Deinstallieren"/></StackPanel></Button>
                    </StackPanel>
                </ScrollViewer>


                <!-- Einstellungen + Version / Changelog -->
                <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="10" Margin="0,20,0,0">

                    <Border Height="1" Background="{StaticResource AppOverlay30}" Margin="2,0,2,4"/>

                    <Button x:Name="NavAutostartButton" Click="Autostart_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="16" MinHeight="44" Padding="12">
                        <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE768;" FontSize="18"/><TextBlock x:Name="LblNavAutostart" Text="Autostart" FontWeight="SemiBold"/></StackPanel>
                    </Button>

                    <Button x:Name="NavHistoryButton"
                            Click="History_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            CornerRadius="16"
                            MinHeight="44"
                            Padding="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE81C;" Foreground="{StaticResource AppForegroundBrush}" FontSize="18"/>
                            <TextBlock x:Name="LblNavHistory" Text="Verlauf" Foreground="{StaticResource AppForegroundBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>

                    <Grid>
                        <Button x:Name="NavSettingsButton" Padding="12"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                CornerRadius="16"
                                MinHeight="44"
                                Background="{StaticResource AppOverlay18}"
                                BorderBrush="{StaticResource AppOverlay30}"
                                BorderThickness="1"
                                Click="SettingsButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE713;" Foreground="{StaticResource AppForegroundBrush}" FontSize="18"/>
                                <TextBlock x:Name="LblNavSettings" Text="Einstellungen"
                                           Foreground="{StaticResource AppForegroundBrush}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Kleiner Hinweis-Badge, falls ein Update verfügbar ist
                             (wird beim App-Start im Hintergrund geprüft, siehe
                             CheckForUpdateInBackgroundAsync in MainWindow.xaml.cs). -->
                        <Border x:Name="UpdateAvailableBadge"
                                Width="18" Height="18"
                                CornerRadius="9"
                                Background="#E74C3C"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,-6,-6,0"
                                Visibility="Collapsed"
                                IsHitTestVisible="False">
                            <TextBlock Text="1"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <Button x:Name="NavChangelogButton" Padding="12"
        HorizontalAlignment="Stretch"
        HorizontalContentAlignment="Stretch"
        CornerRadius="16"
        Background="{StaticResource AppOverlay18}"
        BorderBrush="{StaticResource AppOverlay30}"
        BorderThickness="1"
        Click="ChangelogButton_Click">

                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE789;"
                          Foreground="{StaticResource AppForegroundBrush}"
                          FontSize="18"/>

                                <TextBlock x:Name="NavVersionText"
                Foreground="{StaticResource AppForegroundBrush}"
                FontWeight="SemiBold"/>
                            </StackPanel>

                            <TextBlock x:Name="LblNavChangelogHint" Margin="0,8,0,0"
                       Foreground="{StaticResource AppMutedForegroundBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Text="Changelog anzeigen"/>
                        </StackPanel>
                    </Button>

                    <Grid x:Name="SidebarFooterLinks" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Padding="10"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                CornerRadius="16"
                                Background="{StaticResource AppOverlay18}"
                                BorderBrush="{StaticResource AppOverlay30}"
                                BorderThickness="1"
                                Click="ContactButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE715;" Foreground="{StaticResource AppForegroundBrush}" FontSize="15"/>
                                <TextBlock x:Name="LblNavContact" Text="Kontakt"
                                           Foreground="{StaticResource AppForegroundBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="1"
                                Padding="10"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                CornerRadius="16"
                                Background="{StaticResource AppOverlay18}"
                                BorderBrush="{StaticResource AppOverlay30}"
                                BorderThickness="1"
                                Click="KofiButton_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEB51;" Foreground="{StaticResource AppForegroundBrush}" FontSize="15"/>
                                <TextBlock Text="Ko-fi"
                                           Foreground="{StaticResource AppForegroundBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>


        <!-- MAIN GLASS -->
        <Border x:Name="MainCard"
                Grid.Column="1"
                Margin="12,44,12,12"
                CornerRadius="16"
                Background="{StaticResource AppOverlay10}"
                BorderBrush="{StaticResource AppOverlay1E}"
                BorderThickness="1"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                        <StackPanel Orientation="Horizontal"
                Spacing="12"
                VerticalAlignment="Center">

                            <TextBlock x:Name="PageTitle"
                   Text="Dashboard"
                   FontSize="34"
                   FontWeight="Bold"
                   Foreground="{StaticResource AppForegroundBrush}"/>

                            <ProgressRing x:Name="UpdatesLoadingRing"
                      IsActive="False"
                      Visibility="Collapsed"
                      Width="22"
                      Height="22"
                      VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="PageSubtitle"
               Foreground="{StaticResource AppFaintForegroundBrush}"/>
                    </StackPanel>

                    <!-- Nur auf der Apps-Seite sichtbar -->
                    <StackPanel x:Name="AppsActionBar"
            Grid.Row="0"
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="10"
            VerticalAlignment="Center"
                    Visibility="Collapsed">

                        <TextBox x:Name="WingetSearchBox"
            PlaceholderText="Update suchen..."
            Width="220"
            Height="42"
            Padding="12,9,12,0"
            CornerRadius="8"
            VerticalAlignment="Center"
            VerticalContentAlignment="Stretch"
            AutomationProperties.Name="Verfügbare Updates durchsuchen"
            TabIndex="1"
            TextChanged="WingetSearchBox_TextChanged"/>

                        <Button x:Name="WingetClearSearchButton"
                                Width="38" Height="42" Padding="0"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Update-Suche leeren"
                                Click="WingetClearSearch_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="12"/>
                        </Button>

                        <Button x:Name="WingetSelectAllButton"
            FontSize="14"
            FontWeight="SemiBold"
            Height="42"
            MinWidth="154"
            CornerRadius="8"
            AutomationProperties.Name="Sichtbare Updates auswählen oder abwählen"
            TabIndex="2"
            Padding="14,8"
            Click="WingetSelectAll_Click">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <Border x:Name="WingetSelectAllIndicator"
                                        Width="18" Height="18" CornerRadius="4"
                                        Background="{StaticResource AppAccentBrush}"
                                        BorderBrush="{StaticResource AppAccentBrushLight}"
                                        BorderThickness="1">
                                    <FontIcon x:Name="WingetSelectAllIcon" Glyph="&#xE73E;" FontSize="10" Foreground="White"/>
                                </Border>
                                <TextBlock x:Name="WingetSelectAllText" Text="Alle abwählen" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="RefreshButton"
            FontSize="15"
            FontWeight="SemiBold"
            Height="42"
            AutomationProperties.Name="Update-Liste aktualisieren"
            TabIndex="3"
            Padding="16,10"
            Click="Refresh_Click"><FontIcon Glyph="&#xE72C;"/></Button>

                        <Button x:Name="StartUpdateButton"
            Content="Updates installieren"
            FontSize="15"
            FontWeight="SemiBold"
            Height="42"
            AutomationProperties.Name="Ausgewählte Updates installieren"
            TabIndex="4"
            Padding="16,10"
            Click="StartUpdate_Click"
            Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>

                    <!-- Nur auf der Systeminfo-Seite sichtbar -->
                    <StackPanel x:Name="SystemActionBar"
            Grid.Row="0"
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="10"
            VerticalAlignment="Center"
            Visibility="Collapsed">

                        <Button x:Name="RefreshSystemInfoButton" Content="Aktualisieren"
            FontSize="15"
            FontWeight="SemiBold"
            Padding="16,10"
            Click="RefreshSystemInfo_Click"/>

                        <Button x:Name="ExpandAllSystemButton" Content="Alles aufklappen"
            FontSize="15"
            FontWeight="SemiBold"
            Padding="16,10"
            Click="ExpandAllSystem_Click"/>

                        <Button x:Name="CollapseAllSystemButton" Content="Alles einklappen"
            FontSize="15"
            FontWeight="SemiBold"
            Padding="16,10"
            Click="CollapseAllSystem_Click"/>
                    </StackPanel>

                    <!-- Nur auf der Storage-Seite sichtbar -->
                    <StackPanel x:Name="StorageActionBar"
            Grid.Row="0"
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="10"
            VerticalAlignment="Center"
            Visibility="Collapsed">

                        <Button x:Name="StorageSelectAllButton"
            Content="Alle auswählen"
            FontSize="15"
            FontWeight="SemiBold"
            Padding="16,10"
            Click="StorageSelectAll_Click"/>

                        <Button x:Name="StorageRefreshButton"
            Content="Aktualisieren"
            FontSize="15"
            FontWeight="SemiBold"
            Padding="16,10"
            Click="StorageRefresh_Click"/>

                        <Button x:Name="StorageDeleteSelectedButton"
            Content="Alle ausgewählten löschen"
            FontSize="15"
            FontWeight="SemiBold"
            Padding="16,10"
            Background="#28FF6B6B"
            BorderBrush="#66FF6B6B"
            BorderThickness="1"
            Click="StorageDeleteSelected_Click"
            />
                    </StackPanel>

                    <!-- Nur auf der Deinstaller-Seite sichtbar -->
                    <StackPanel x:Name="UninstallActionBar"
            Grid.Row="0"
            Grid.Column="1"
            Orientation="Horizontal"
            Spacing="10"
            VerticalAlignment="Center"
            Visibility="Collapsed">

                        <TextBox x:Name="UninstallSearchBox"
            PlaceholderText="Programm suchen..."
            Width="220"
            Height="42"
            Padding="12,9,12,0"
            CornerRadius="8"
            VerticalAlignment="Center"
            VerticalContentAlignment="Stretch"
            AutomationProperties.Name="Installierte Programme durchsuchen"
            TabIndex="1"
            TextChanged="UninstallSearchBox_TextChanged"/>

                        <Button x:Name="UninstallClearSearchButton"
                                Width="38" Height="42" Padding="0"
                                Visibility="Collapsed"
                                AutomationProperties.Name="Programmsuche leeren"
                                Click="UninstallClearSearch_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="12"/>
                        </Button>

                        <Button x:Name="UninstallRefreshButton"
            Content="Aktualisieren"
            FontSize="15"
            FontWeight="SemiBold"
            Height="42"
            AutomationProperties.Name="Programmliste aktualisieren"
            TabIndex="2"
            Padding="16,10"
            Click="UninstallRefresh_Click"/>

                        <Button x:Name="UninstallExportButton"
                                Content="Liste exportieren"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Height="42"
                                Padding="14,10"
                                AutomationProperties.Name="Liste aller installierten Programme exportieren">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Als TXT exportieren" Click="UninstallExportTxt_Click"/>
                                    <MenuFlyoutItem Text="Als CSV exportieren (Komma)" Tag="," Click="UninstallExportCsv_Click"/>
                                    <MenuFlyoutItem Text="Als CSV für deutsches Excel (Semikolon)" Tag=";" Click="UninstallExportCsv_Click"/>
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Fortschrittsanzeige während der Installation -->
                <StackPanel x:Name="UpdateProgressPanel"
                            Grid.Row="1"
                            Spacing="6"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">

                    <TextBlock x:Name="UpdateProgressText"
                               Foreground="{StaticResource AppForegroundBrush}"
                               FontSize="13"/>

                    <ProgressBar x:Name="UpdateProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Foreground="{StaticResource AppAccentBrush}"/>

                    <TextBlock x:Name="CurrentPackageStatusText"
                               Foreground="{StaticResource AppFaintForegroundBrush}"
                               FontSize="12"/>

                    <ProgressBar x:Name="CurrentPackageProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Height="4"
                                 Foreground="{StaticResource AppAccentBrush}"/>

                    <Button x:Name="CancelUpdateButton"
                            Content="Abbrechen"
                            HorizontalAlignment="Right"
                            Visibility="Collapsed"
                            AutomationProperties.Name="Laufenden Updatevorgang abbrechen"
                            Click="CancelUpdate_Click"/>
                </StackPanel>

                <!-- Fortschrittsanzeige während der Bereinigung -->
                <StackPanel x:Name="StorageProgressPanel"
                            Grid.Row="1"
                            Spacing="6"
                            Margin="0,0,0,10"
                            Visibility="Collapsed">

                    <TextBlock x:Name="StorageProgressText"
                               Foreground="{StaticResource AppForegroundBrush}"
                               FontSize="13"/>

                    <ProgressBar x:Name="StorageProgressBar"
                                 Minimum="0"
                                 Maximum="100"
                                 Foreground="{StaticResource AppAccentBrush}"/>
                </StackPanel>

                <!-- Status während eine Programm-Deinstallation gestartet wird -->
                <Border x:Name="UninstallStatusPanel"
                        Grid.Row="1"
                        Margin="0,0,0,10"
                        Padding="14,10"
                        CornerRadius="10"
                        Background="{StaticResource AppOverlay18}"
                        BorderBrush="{StaticResource AppOverlay28}"
                        BorderThickness="1"
                        Visibility="Collapsed">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ProgressRing x:Name="UninstallStatusRing" Width="18" Height="18" IsActive="True"/>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Name="UninstallStatusText" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock x:Name="UninstallStatusDetailText" FontSize="11" Foreground="{StaticResource AppFaintForegroundBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <FontIcon x:Name="UninstallStatusIcon" Grid.Column="2" FontSize="17" Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="MainContentScrollViewer" Grid.Row="2"
              HorizontalScrollBarVisibility="Disabled"
              VerticalScrollBarVisibility="Auto"
              Padding="0,0,24,0">

                    <Grid>

                        <!-- SYSTEM -->

                        <!-- OVERVIEW -->
                        <StackPanel x:Name="OverviewPanel"
            Spacing="24"
            HorizontalAlignment="Stretch"
            Visibility="Visible">

                            <!-- ===== Statuskarten (groß, mit Icons) ===== -->
                            <Grid x:Name="DashboardStatusGrid" ColumnSpacing="16" RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="0"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border x:Name="StatCardCpu" Grid.Column="1" CornerRadius="16" Padding="24"
                                        MinHeight="150"
                                        Background="{StaticResource AppOverlay1A}"
                                        BorderBrush="{StaticResource AppOverlay28}"
                                        BorderThickness="1"
                                        ToolTipService.ToolTip="Aktuelle CPU-Auslastung in Prozent">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE7F8;" FontSize="18" Foreground="{StaticResource AppAccentBrushLight}"/>
                                            <TextBlock x:Name="LblStatCpu" Text="CPU" FontSize="15" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="HealthCpuText" Text="--%" FontSize="36" FontWeight="Bold" Foreground="{StaticResource AppForegroundBrush}"/>
                                        <TextBlock x:Name="LblStatCpuSub" Text="Auslastung" FontSize="12" Foreground="{StaticResource AppFaintForegroundBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="StatCardRam" Grid.Column="2" CornerRadius="16" Padding="24"
                                        MinHeight="150"
                                        Background="{StaticResource AppOverlay1A}"
                                        BorderBrush="{StaticResource AppOverlay28}"
                                        BorderThickness="1"
                                        ToolTipService.ToolTip="Aktuelle RAM-Auslastung, genutzt / gesamt">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xEEA1;" FontSize="18" Foreground="{StaticResource AppAccentBrushLight}"/>
                                            <TextBlock x:Name="LblStatRam" Text="RAM" FontSize="15" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="HealthRamText" Text="--%" FontSize="36" FontWeight="Bold" Foreground="{StaticResource AppForegroundBrush}"/>
                                        <TextBlock x:Name="HealthRamDetailText" Text="Auslastung" FontSize="12" Foreground="{StaticResource AppFaintForegroundBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="StatCardGpu" Grid.Column="3" CornerRadius="16" Padding="24"
                                        MinHeight="150"
                                        Background="{StaticResource AppOverlay1A}"
                                        BorderBrush="{StaticResource AppOverlay28}"
                                        BorderThickness="1"
                                        ToolTipService.ToolTip="Aktuelle GPU-Auslastung (falls von der Hardware unterstützt)">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE950;" FontSize="18" Foreground="{StaticResource AppAccentBrushLight}"/>
                                            <TextBlock x:Name="LblStatGpu" Text="GPU" FontSize="15" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="HealthGpuText" Text="--" FontSize="36" FontWeight="Bold" Foreground="{StaticResource AppForegroundBrush}"/>
                                        <TextBlock x:Name="LblStatGpuSub" Text="Auslastung" FontSize="12" Foreground="{StaticResource AppFaintForegroundBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="StatCardSecurity" Grid.Column="4" CornerRadius="16" Padding="24" Tapped="SecurityCard_Tapped"
                                        MinHeight="150"
                                        Background="{StaticResource AppOverlay1A}"
                                        BorderBrush="{StaticResource AppOverlay28}"
                                        BorderThickness="1"
                                        ToolTipService.ToolTip="Status von Windows Defender und Firewall">
                                    <StackPanel Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xEA18;" FontSize="18" Foreground="{StaticResource AppAccentBrushLight}"/>
                                            <TextBlock x:Name="LblStatSecurity" Text="Sicherheit" FontSize="15" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="HealthSecurityText" Text="--" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AppForegroundBrush}"/>
                                        <TextBlock x:Name="LblStatSecuritySub" Text="Defender / Firewall" FontSize="12" Foreground="{StaticResource AppFaintForegroundBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="StatCardUpdates" Grid.Column="0" Tapped="DashUpdates_Tapped" CornerRadius="16" Padding="24"
                                        MinHeight="150"
                                        Background="{StaticResource AppOverlay1A}"
                                        BorderBrush="{StaticResource AppOverlay28}"
                                        BorderThickness="1"
                                        ToolTipService.ToolTip="Programm-Updates öffnen">
