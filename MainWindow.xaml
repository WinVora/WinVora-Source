                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE896;" FontSize="18" Foreground="{StaticResource AppAccentBrushLight}"/>
                                            <TextBlock x:Name="LblStatUpdates" Text="Updates" FontSize="15" Foreground="{StaticResource AppMutedForegroundBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="HealthUpdatesText" Text="--" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AppForegroundBrush}"/>
                                        <TextBlock x:Name="LblStatUpdatesSub" Text="Update-Pakete" FontSize="12" Foreground="{StaticResource AppFaintForegroundBrush}"/>
                                    </StackPanel>
                                </Border>
