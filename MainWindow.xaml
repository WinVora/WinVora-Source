                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="SysLbl19" Text="Mainboard" FontSize="16" Foreground="{StaticResource AppMutedForegroundBrush}"/>
