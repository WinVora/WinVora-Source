<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>

		<!-- WinUI 3 -->
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>

		<RootNamespace>WinVora</RootNamespace>
		<AssemblyName>WinVora</AssemblyName>
		<Version>0.8.2</Version>
		<InformationalVersion>$(Version)</InformationalVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<ApplicationIcon>app.ico</ApplicationIcon>

		<UseWinUI>true</UseWinUI>

		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Architektur fix -->
		<PlatformTarget>x64</PlatformTarget>

		<!-- Self-Contained: für dotnet publish, damit die App auch auf PCs
		     ohne installiertes .NET/Windows App SDK läuft (z.B. zum Testen
		     bei Freunden). Für den normalen Debug-Build in Visual Studio
		     ändert sich dadurch nichts. -->
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

		<!-- PublishSingleFile war früher aktiv ("nur eine .exe zum Weitergeben"),
		     verursacht aber in Kombination mit WindowsAppSDKSelfContained bei
		     dieser SDK-Version einen Bug: aus 186 MB (489 Dateien) wurden beim
		     Bündeln plötzlich 1,87 GB - offenbar werden Dateien beim Bündeln
		     dupliziert statt nur zusammengepackt. Deshalb wieder deaktiviert.
		     Brauchen wir ohnehin nicht mehr: der Installer (WinVoraSetup.iss)
		     packt den kompletten publish-Ordner sowieso in eine einzige
		     Setup.exe, egal ob darin 1 oder 489 Dateien stecken. -->

		<!-- Keine .pdb-Datei mehr im Publish-Output -->
		<DebugType>none</DebugType>

		<!-- Reduziert die vielen af-ZA/am-ET/... Sprachordner im Publish-Output
		     auf die tatsächlich benötigten Sprachen. -->
		<SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>

		<!-- MSIX-Paketierung bleibt deaktiviert (WindowsPackageType/AppxPackage),
		     aber das MSIX-Tooling selbst muss an sein, damit PublishSingleFile
		     die resources.pri in die .exe einbetten kann. -->
		<WindowsPackageType>None</WindowsPackageType>
		<EnableMsixTooling>true</EnableMsixTooling>
		<AppxPackage>false</AppxPackage>

		<!-- XAML / Build Stabilität -->
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<EnableDefaultPageItems>true</EnableDefaultPageItems>
		<Platforms>x64</Platforms>

	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
		<PackageReference Include="System.Management" Version="10.0.2" />
		<PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
		<PackageReference Include="System.Drawing.Common" Version="8.0.0" />
		<PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="app.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="app-logo.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!-- Schließt ungenutzte KI/ML-Laufzeitkomponenten aus, die das
	     Windows App SDK 2.2.0 standardmäßig mitbringt (ONNX Runtime,
	     Windows-AI-Foundation-Projections für Copilot+-Funktionen). WinVora
	     ruft keine dieser APIs auf - ohne sie ist der Build deutlich kleiner.
	     Falls nach einem Update der App irgendwas Unerwartetes nicht mehr
	     funktioniert: dieses Target einfach komplett entfernen/auskommentieren. -->
	<Target Name="RemoveUnusedAIRuntimeFiles" AfterTargets="ComputeResolvedFilesToPublishList">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
				Condition="$([System.String]::Copy('%(ResolvedFileToPublish.FileName)').StartsWith('Microsoft.Windows.AI')) or
				           $([System.String]::Copy('%(ResolvedFileToPublish.FileName)').StartsWith('Microsoft.Windows.Internal.AI')) or
				           $([System.String]::Copy('%(ResolvedFileToPublish.FileName)').StartsWith('Microsoft.Windows.Vision')) or
				           $([System.String]::Copy('%(ResolvedFileToPublish.FileName)').StartsWith('Microsoft.Windows.SemanticSearch')) or
				           $([System.String]::Copy('%(ResolvedFileToPublish.FileName)').StartsWith('Microsoft.ML.OnnxRuntime')) or
				           '%(ResolvedFileToPublish.FileName)' == 'onnxruntime' or
				           '%(ResolvedFileToPublish.FileName)' == 'NPUDetect' or
				           '%(ResolvedFileToPublish.FileName)' == 'PerceptiveStreaming' or
				           '%(ResolvedFileToPublish.FileName)' == 'System.Numerics.Tensors'" />
		</ItemGroup>
	</Target>

</Project>
