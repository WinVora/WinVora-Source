<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>

		<!-- WinUI 3 -->
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>

		<RootNamespace>WinVora</RootNamespace>
		<AssemblyName>WinVora</AssemblyName>
		<ApplicationIcon>app.ico</ApplicationIcon>

		<UseWinUI>true</UseWinUI>

		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Architektur fix -->
		<PlatformTarget>x64</PlatformTarget>

		<!-- Self-Contained: für dotnet publish, damit die App auch auf PCs
		     ohne installiertes .NET/Windows App SDK läuft (z.B. zum Testen
		     bei Freunden). Für den normalen Debug-Build in Visual Studio
		     ändert sich dadurch nichts. -->
		<SelfContained>true</SelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

		<!-- Bündelt die vielen einzelnen .dll-Dateien in die .exe. Bei
		     Windows-App-SDK-Apps bleiben trotzdem meist noch 1-2 Dateien
		     (z.B. resources.pri) neben der .exe liegen - eine 100%ige
		     Einzeldatei ohne jede Nebendatei ist hier offiziell nicht
		     garantiert, aber es wird deutlich weniger als vorher. -->
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

		<!-- Keine .pdb-Datei mehr im Publish-Output - dann bleibt wirklich nur die .exe übrig -->
		<DebugType>none</DebugType>

		<!-- Reduziert die vielen af-ZA/am-ET/... Sprachordner im Publish-Output
		     auf die tatsächlich benötigten Sprachen. -->
		<SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>

		<!-- MSIX-Paketierung bleibt deaktiviert (WindowsPackageType/AppxPackage),
		     aber das MSIX-Tooling selbst muss an sein, damit PublishSingleFile
		     die resources.pri in die .exe einbetten kann. -->
		<WindowsPackageType>None</WindowsPackageType>
		<EnableMsixTooling>true</EnableMsixTooling>
		<AppxPackage>false</AppxPackage>

		<!-- XAML / Build Stabilität -->
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<EnableDefaultPageItems>true</EnableDefaultPageItems>
		<Platforms>x64</Platforms>

	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
		<PackageReference Include="System.Management" Version="8.0.0" />
		<PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="app.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>